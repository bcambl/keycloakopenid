{% set client = keycloak_clients | selectattr('id', 'equalto', 'helloworld-shared') | first %}
{% for app in helloworld_apps %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: {{ app.name }}-shared-auth
  namespace: {{ demo_namespace }}
  labels:
    app.kubernetes.io/part-of: keycloakopenid-demo
    demo-mode: shared
spec:
  plugin:
    keycloakopenid:
      KeycloakURL: {{ keycloak_url }}
      InsecureSkipVerify: true
      ClientID: {{ client.id }}
      ClientSecret: {{ client.secret }}
      KeycloakRealm: demo
      Scope: openid profile email
      UseAuthHeader: true
      CallbackURL: https://{{ vm_host }}{{ client.callback }}
      RefreshBeforeExpiry: 2s
      IgnorePathPrefixes: /{{ app.name }}/favicon.ico,/{{ app.name }}/healthz
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: {{ app.name }}-shared-strip
  namespace: {{ demo_namespace }}
  labels:
    app.kubernetes.io/part-of: keycloakopenid-demo
    demo-mode: shared
spec:
  stripPrefix:
    prefixes:
      - /{{ app.name }}
{% endfor %}
---
# Two routers, each referencing its own middleware, share one Keycloak client.
# Traefik creates a plugin instance per middleware, but every instance configured
# with the same Keycloak URL, realm and client ID shares one process-wide session
# store and one host-only cookie, so a login through either middleware
# authenticates both paths. The fixed callback route reuses the first middleware.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: helloworld-shared
  namespace: {{ demo_namespace }}
  labels:
    app.kubernetes.io/part-of: keycloakopenid-demo
    demo-mode: shared
spec:
  entryPoints:
    - websecure
  routes:
    - kind: Rule
      match: PathPrefix(`/callback`)
      middlewares:
        - name: {{ helloworld_apps[0].name }}-shared-auth
      services:
        - name: {{ helloworld_apps[0].name }}
          port: 80
{% for app in helloworld_apps %}
    - kind: Rule
      match: PathPrefix(`/{{ app.name }}`)
      middlewares:
        - name: {{ app.name }}-shared-auth
        - name: {{ app.name }}-shared-strip
      services:
        - name: {{ app.name }}
          port: 80
{% endfor %}
  tls:
    secretName: demo-tls
