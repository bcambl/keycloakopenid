apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    ports:
      web:
        redirectTo:
          port: websecure
    providers:
      kubernetesCRD:
        allowCrossNamespace: true
{% if vm_host is not match('^[0-9.]+$') %}
    deployment:
      hostAliases:
        - ip: "{{ ansible_default_ipv4.address }}"
          hostnames:
            - "{{ vm_host }}"
{% endif %}
    experimental:
      localPlugins:
        keycloakopenid:
          moduleName: {{ plugin_module_name }}
          mountPath: {{ plugin_mount_path }}
          type: hostPath
          hostPath: {{ plugin_source_path }}