{% for app in helloworld_apps %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app.name }}
  namespace: {{ demo_namespace }}
  labels:
    app.kubernetes.io/part-of: keycloakopenid-demo
    app.kubernetes.io/name: {{ app.name }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ app.name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: keycloakopenid-demo
        app.kubernetes.io/name: {{ app.name }}
      annotations:
        keycloakopenid.demo/image-id: "{{ helloworld_image_id }}"
    spec:
      containers:
        - name: {{ app.name }}
          image: {{ helloworld_image }}
          imagePullPolicy: Never
          env:
            - name: APP_NAME
              value: {{ app.name }}
            - name: OTHER_APP_URL
              value: /{{ app.other }}/
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app.name }}
  namespace: {{ demo_namespace }}
  labels:
    app.kubernetes.io/part-of: keycloakopenid-demo
    app.kubernetes.io/name: {{ app.name }}
spec:
  selector:
    app.kubernetes.io/name: {{ app.name }}
  ports:
    - name: http
      port: 80
      targetPort: http
{% endfor %}
